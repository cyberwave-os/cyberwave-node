# Default: no credentials and no physical commands. Run the bundled fixture.
DEMO_MODE=fixture
# Connected mode requires a server-held API token and a single authorized environment.
CYBERWAVE_API_URL=http://localhost:8000
CYBERWAVE_API_TOKEN=
CYBERWAVE_ENVIRONMENT_UUID=
# Optional comma-separated restriction in addition to environment membership.
CYBERWAVE_TWIN_UUIDS=
CYBERWAVE_ALLOW_EXECUTION=false
# WGS84 longitude/latitude (degrees), ellipsoid height (meters).
DEMO_LONGITUDE=12.4964
DEMO_LATITUDE=41.9028
DEMO_ELLIPSOID_HEIGHT=0
# Local +X heading counterclockwise from East; local +Z is Up, units meters.
DEMO_YAW_DEGREES=0
# Explicitly verify calibration before enabling connected command dispatch.
DEMO_GEOREF_VERIFIED=false
# This example runs locally only; these settings are not deployed infrastructure.

# Optional controller examples: assigned simulation-only velocity policy, server-configured target.
CYBERWAVE_CONTROLLER_TWIN_UUID=
CYBERWAVE_CONTROLLER_UUID=
# preview = local reference consumer; mqtt = input through the local Cyberwave broker.
DEMO_CONTROLLER_TRANSPORT=preview
DEMO_MQTT_URL=mqtt://127.0.0.1:1883
DEMO_MQTT_ENVIRONMENT_PREFIX=local
# Leave blank for cwh_<SHA256(API token)> identity; older brokers may require explicit local credentials.
DEMO_MQTT_USERNAME=
DEMO_MQTT_PASSWORD=
# Optional bounded CPU MuJoCo workload lifecycle; use a dedicated local test environment.
# Backend simulation start/stop may stop other controllers in that environment.
DEMO_ALLOW_SIMULATION_LAUNCH=false
