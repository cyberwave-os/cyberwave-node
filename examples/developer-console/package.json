{
  "name": "cyberwave-developer-console",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "server": "node --env-file-if-exists=.env server.mjs",
    "build": "tsc --noEmit && vite build",
    "test": "node --test tests/*.test.ts",
    "smoke:local": "node scripts/local-smoke.mjs"
  },
  "dependencies": {
    "cesium": "1.146.0",
    "mqtt": "5.16.0",
    "cyberwave": "workspace:^",
    "@cyberwave/react": "workspace:^",
    "@cyberwave/environment-3d": "workspace:^",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vite": "8.3.3",
    "vite-plugin-static-copy": "4.1.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "26.1.0"
  }
}
