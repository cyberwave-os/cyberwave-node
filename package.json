{
  "name": "cyberwave",
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "build": "pnpm build:sdk && pnpm --filter @cyberwave/environment-3d build && pnpm --filter @cyberwave/react build && pnpm --filter cyberwave-developer-console build",
    "test": "node --test tests/*.test.ts && pnpm --filter cyberwave-developer-console test",
    "dev": "pnpm --filter cyberwave-developer-console dev",
    "server": "pnpm --filter cyberwave-developer-console server",
    "build:sdk": "tsc -p tsconfig.json && pnpm recipes:check",
    "pack:check": "node scripts/check-packages.mjs",
    "recipes:check": "tsc -p examples/recipes/tsconfig.json"
  },
  "devDependencies": {
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "@types/node": "^24.0.0"
  },
  "description": "Typed Cyberwave client and framework-independent environment loading",
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./generated": {
      "types": "./dist/generated/schema.d.ts",
      "import": "./dist/generated/schema.js"
    }
  },
  "dependencies": {
    "openapi-fetch": "0.17.0"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/cyberwave-os/cyberwave-node.git"
  },
  "homepage": "https://github.com/cyberwave-os/cyberwave-node#readme",
  "bugs": {
    "url": "https://github.com/cyberwave-os/cyberwave-node/issues"
  },
  "author": "Cyberwave S.p.a."
}
