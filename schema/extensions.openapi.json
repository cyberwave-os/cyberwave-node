{
  "openapi": "3.1.0",
  "info": {
    "title": "Cyberwave development extensions",
    "version": "0.1.0-preview",
    "description": "Additive endpoints implemented on CYB-4234; deployment availability must be checked separately."
  },
  "paths": {
    "/api/v1/environments/{uuid}/inspection-campaigns": {
      "post": {
        "operationId": "src_app_api_inspections_import_inspection_campaign",
        "summary": "Import Inspection Campaign",
        "parameters": [
          {
            "in": "path",
            "name": "uuid",
            "schema": {
              "title": "Uuid",
              "type": "string"
            },
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InspectionCampaignDetailSchema"
                }
              }
            }
          }
        },
        "description": "Atomically import metadata; repeat the same external_id and body to retry.\n\nChanges require a new campaign external_id. Existing source observations and\nreview revisions are never overwritten by an import.",
        "tags": [
          "Inspections"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ImportInspectionCampaignInput"
              }
            }
          },
          "required": true
        },
        "security": [
          {
            "CustomTokenAuthentication": []
          }
        ]
      },
      "get": {
        "operationId": "src_app_api_inspections_list_inspection_campaigns",
        "summary": "List Inspection Campaigns",
        "parameters": [
          {
            "in": "path",
            "name": "uuid",
            "schema": {
              "title": "Uuid",
              "type": "string"
            },
            "required": true
          },
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "default": 50,
              "maximum": 1000,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            },
            "required": false
          },
          {
            "in": "query",
            "name": "offset",
            "schema": {
              "default": 0,
              "maximum": 1000000,
              "minimum": 0,
              "title": "Offset",
              "type": "integer"
            },
            "required": false
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/InspectionCampaignSchema"
                  },
                  "title": "Response",
                  "type": "array"
                }
              }
            }
          }
        },
        "tags": [
          "Inspections"
        ],
        "security": [
          {
            "CustomTokenAuthentication": []
          }
        ]
      }
    },
    "/api/v1/environments/{uuid}/inspection-campaigns/{campaign_uuid}": {
      "get": {
        "operationId": "src_app_api_inspections_get_inspection_campaign",
        "summary": "Get Inspection Campaign",
        "parameters": [
          {
            "in": "path",
            "name": "uuid",
            "schema": {
              "title": "Uuid",
              "type": "string"
            },
            "required": true
          },
          {
            "in": "path",
            "name": "campaign_uuid",
            "schema": {
              "format": "uuid",
              "title": "Campaign Uuid",
              "type": "string"
            },
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InspectionCampaignDetailSchema"
                }
              }
            }
          }
        },
        "tags": [
          "Inspections"
        ],
        "security": [
          {
            "CustomTokenAuthentication": []
          }
        ]
      }
    },
    "/api/v1/environments/{uuid}/inspection-defects/{defect_uuid}/observations": {
      "get": {
        "operationId": "src_app_api_inspections_get_inspection_defect_history",
        "summary": "Get Inspection Defect History",
